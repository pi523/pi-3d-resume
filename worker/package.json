{
  "name": "enge-site-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute enge-site --local --file=./schema.sql",
    "db:init": "wrangler d1 execute enge-site --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
